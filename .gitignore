.venv/
.env
.info/

# Python
__pycache__/
*.py[cod]
*$py.class

# Rollout and Labeled data (large, environment-generated)
data/rollouts/
data/labeled/

# Model checkpoints
checkpoints/

# Baseline-only agent (build 01-03, superseded by the verifier-centered pipeline; kept locally
# for anyone who clones the repo and wants to regenerate baseline numbers, not tracked publicly)
agents/single_agent.py

# Superseded labeler (build 11's TD/GAE experiment, "a wash vs MC" -- see results.md; kept
# locally so the comparison can be rerun, not tracked publicly as if it were current work)
rollout/label_td.py

# Rule-based labeler: worked mechanically, explicitly rejected on principle (replaces
# environment-outcome learning with a hand-written rubric -- see results.md). kept locally as a
# documented, closed experiment, not tracked publicly as current work.
rollout/label_rules.py

# Same-state branching-rollout collection: killed early after a smoke test showed most branch
# pairs collapse to diff=0.0000 (TextWorldExpress's reward is too sparse/terminal-concentrated --
# see results.md). closed, documented negative result, not current work.
scripts/collect_branches.py

# macOS
.DS_Store

reports/